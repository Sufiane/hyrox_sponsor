{
  "name": "hyrox-sponsor-api",
  "version": "0.0.0",
  "private": true,
  "description": "Hyrox sponsorship auction backend: NestJS, Prisma, PostgreSQL",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "shared",
    "web"
  ],
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"shared/src/**/*.ts\" \"web/src/**/*.ts\"",
    "test": "vitest run",
    "staff": "node dist/staff-auth/cli/staff-admin.js",
    "lint:arch": "depcruise src --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/s3-request-presigner": "3.1146.0",
    "@nestjs/common": "12.1.1",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.1",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/platform-express": "12.1.1",
    "@nestjs/throttler": "6.7.1",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@nestjs/testing": "12.1.1",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.0",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "prisma": "6.19.3",
    "tsc-alias": "1.9.7",
    "typescript": "6.0.3",
    "vitest": "5.0.2",
    "vitest-mock-extended": "5.1.1"
  }
}
