DATABASE_URL="postgresql://hyrox:hyrox@localhost:5435/hyrox_sponsor?schema=public"
PORT=3000
TRUST_PROXY_HOPS=1
JWT_SECRET=local-dev-only-jwt-secret-change-me-0123456789
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
STAFF_JWT_SECRET=local-dev-only-staff-jwt-secret-0123456789-xyz
STAFF_JWT_TTL_SECONDS=900
STAFF_REFRESH_TOKEN_TTL_SECONDS=604800
CORS_ORIGINS=http://localhost:5173
# Comma-separated hosts allowed in result proof links. Empty refuses all links; fill the real host before launch.
RESULT_PROOF_URL_HOSTS=
STORAGE_ENDPOINT=http://localhost:9005
STORAGE_REGION=us-east-1
STORAGE_BUCKET=hyrox-verification-docs
STORAGE_ACCESS_KEY_ID=hyrox
STORAGE_SECRET_ACCESS_KEY=hyrox-secret

# Test-mode values from the Stripe dashboard; the two webhook secrets must differ. See docs/runbooks/stripe-connect-setup.md.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PLATFORM_WEBHOOK_SECRET=whsec_replace_me_platform
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_replace_me_connect
STRIPE_CONNECT_RETURN_URL=http://localhost:5173/account/payouts?return=1
STRIPE_CONNECT_REFRESH_URL=http://localhost:5173/account/payouts?refresh=1

AUCTION_SCHEDULER_ENABLED=true
